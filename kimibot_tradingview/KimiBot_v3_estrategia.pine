//@version=5
strategy("KimiBot v3 · SMC/ICT/CRT/MSNR (estrategia)", shorttitle="KimiBot v3 S", overlay=true, initial_capital=1000, currency=currency.USD, commission_type=strategy.commission.cash_per_contract, commission_value=0, slippage=2, max_labels_count=300, max_lines_count=400, max_bars_back=500, process_orders_on_close=false)

// ════════════════════════════════════════════════════════════════════════════
// Port a TradingView de KimiBot v3 (github.com/ilham191026-projek/KimiBot)
// Lógica de 6 capas: H4 sesgo · H1 OB/FVG · M30 barrido de Asia · M15 CRT · M5 MSS · M1 entrada
// Filtros: ADX/ATR H1, "spread" (rango de vela M5), sesiones Londres/NY (GMT), cooldown.
// SL desde el barrido CRT M15 ± 2 pips (respaldo: swing M30), TP1 = 1,5R, TP2 = 2,5R.
// Úsalo en un gráfico de 1 MINUTO. No repinta: usa velas cerradas de cada temporalidad.
// Lo que NO se puede portar: narrativa de IA (Groq), calendario económico, mensajes de Telegram.
// Material educativo. No es asesoramiento financiero.
// ════════════════════════════════════════════════════════════════════════════

// ── Entradas ────────────────────────────────────────────────────────────────
preset      = input.string("Ajustado", "Preset", options=["Original (KimiBot)", "Ajustado"], group="General",
     tooltip="Original = mismos valores y comportamiento que el bot en Python (incluida la capa 3 que nunca valida). Ajustado = capa 3 corregida y filtros adaptados al oro.")
minScore    = input.int(5, "Puntuación mínima (de 6)", minval=1, maxval=6, group="General")
cooldownMin = input.int(30, "Cooldown entre señales (min)", minval=0, group="General")
useSession  = input.bool(true, "Solo sesiones Londres 07-12 y NY 13-17 GMT", group="General")
showLevels  = input.bool(true, "Dibujar entrada, SL, TP1 y TP2", group="General")
showPanel   = input.bool(true, "Mostrar panel de capas", group="General")
showNear    = input.bool(true, "Marcar casi-señales (le falta 1 capa)", group="General")
capital     = input.float(1000, "Capital (USD)", minval=1, group="Riesgo")
riskPct     = input.float(1.0, "Riesgo por operación (%)", minval=0.01, step=0.1, group="Riesgo")
adxThr      = input.float(25, "ADX H1 mínimo", group="Filtro de volatilidad")
atrMinAdj   = input.float(40, "Ajustado: ATR H1 mínimo (pips)", group="Preset Ajustado")
atrMaxAdj   = input.float(300, "Ajustado: ATR H1 máximo (pips)", group="Preset Ajustado")
slMaxAdj    = input.float(60, "Ajustado: SL máximo (pips)", group="Preset Ajustado")
spreadAdj   = input.bool(false, "Ajustado: aplicar filtro de rango M5 ≤ 2 pips", group="Preset Ajustado")

isOrig  = preset == "Original (KimiBot)"
tk      = syminfo.ticker
isGold  = str.contains(tk, "XAU") or str.contains(tk, "GOLD")
pip     = str.contains(tk, "JPY") ? 0.01 : isGold ? 0.1 : 0.0001
contract = isGold ? 100.0 : 100000.0
atrMin  = isOrig ? 8.0 : atrMinAdj
atrMax  = isOrig ? 35.0 : atrMaxAdj
slMin   = 15.0
slMax   = isOrig ? 20.0 : slMaxAdj
useSpread = isOrig ? true : spreadAdj

// ── Capa 1: sesgo de H4 (HH/HL frente a LH/LL en las últimas 100 velas) ────
f_h4() =>
    ph = ta.pivothigh(high, 5, 5)
    pl = ta.pivotlow(low, 5, 5)
    var array<float> hP = array.new<float>()
    var array<int>   hI = array.new<int>()
    var array<float> lP = array.new<float>()
    var array<int>   lI = array.new<int>()
    if not na(ph)
        array.push(hP, ph)
        array.push(hI, bar_index - 5)
        if array.size(hP) > 60
            array.shift(hP)
            array.shift(hI)
    if not na(pl)
        array.push(lP, pl)
        array.push(lI, bar_index - 5)
        if array.size(lP) > 60
            array.shift(lP)
            array.shift(lI)
    minIdx = bar_index - 99
    int bull = 0
    int bear = 0
    int nH = 0
    int nL = 0
    float prevH = na
    float prevL = na
    if array.size(hP) > 0
        for k = 0 to array.size(hP) - 1
            if array.get(hI, k) >= minIdx
                v = array.get(hP, k)
                if not na(prevH)
                    if v > prevH
                        bull += 1
                    else
                        bear += 1
                prevH := v
                nH += 1
    if array.size(lP) > 0
        for k = 0 to array.size(lP) - 1
            if array.get(lI, k) >= minIdx
                v = array.get(lP, k)
                if not na(prevL)
                    if v > prevL
                        bull += 1
                    else
                        bear += 1
                prevL := v
                nL += 1
    total = bull + bear
    int bias = 0
    if nH >= 2 and nL >= 2 and total > 0
        bias := bull * 1.0 / total > 0.6 ? 1 : bear * 1.0 / total > 0.6 ? -1 : 0
    bias[1]

// ── Capa 2: Order Blocks y FVG de H1 + ADX/ATR del filtro ──────────────────
f_h1() =>
    var array<float> bT = array.new<float>()
    var array<float> bB = array.new<float>()
    var array<int>   bI = array.new<int>()
    var array<float> sT = array.new<float>()
    var array<float> sB = array.new<float>()
    var array<int>   sI = array.new<int>()
    var array<float> fT = array.new<float>()
    var array<float> fB = array.new<float>()
    var array<int>   fD = array.new<int>()
    var array<int>   fI = array.new<int>()
    rng = high - low + 1e-10
    // última vela bajista y alcista vistas (sin usar historial dentro de bucles)
    var int   lbI = na
    var float lbH = na
    var float lbL = na
    var int   luI = na
    var float luH = na
    var float luL = na
    if bar_index >= 10
        if close > open and (close - open) / rng >= 0.5 and not na(lbI) and bar_index - lbI <= 9
            array.push(bT, lbH)
            array.push(bB, lbL)
            array.push(bI, bar_index)
            if array.size(bT) > 3
                array.shift(bT)
                array.shift(bB)
                array.shift(bI)
        if close < open and (open - close) / rng >= 0.5 and not na(luI) and bar_index - luI <= 9
            array.push(sT, luH)
            array.push(sB, luL)
            array.push(sI, bar_index)
            if array.size(sT) > 3
                array.shift(sT)
                array.shift(sB)
                array.shift(sI)
    if close < open
        lbI := bar_index
        lbH := high
        lbL := low
    if close > open
        luI := bar_index
        luH := high
        luL := low
    if bar_index >= 2
        if low > high[2]
            array.push(fT, low)
            array.push(fB, high[2])
            array.push(fD, 1)
            array.push(fI, bar_index)
        else if high < low[2]
            array.push(fT, low[2])
            array.push(fB, high)
            array.push(fD, -1)
            array.push(fI, bar_index)
        if array.size(fT) > 3
            array.shift(fT)
            array.shift(fB)
            array.shift(fD)
            array.shift(fI)
    minIdx = bar_index - 99
    int nBull = 0
    int nBear = 0
    bool nearBull = false
    bool nearBear = false
    if array.size(bT) > 0
        for k = 0 to array.size(bT) - 1
            if array.get(bI, k) >= minIdx
                nBull += 1
                if close >= array.get(bB, k) and close <= array.get(bT, k)
                    nearBull := true
    if array.size(sT) > 0
        for k = 0 to array.size(sT) - 1
            if array.get(sI, k) >= minIdx
                nBear += 1
                if close >= array.get(sB, k) and close <= array.get(sT, k)
                    nearBear := true
    int unmit = 0
    if array.size(fT) > 0
        for k = 0 to array.size(fT) - 1
            if array.get(fI, k) >= minIdx
                d = array.get(fD, k)
                if (d == 1 and close > array.get(fT, k)) or (d == -1 and close < array.get(fB, k))
                    unmit += 1
    vBull = nBull > 0 and (nearBull or unmit > 0)
    vBear = nBear > 0 and (nearBear or unmit > 0)
    // ADX y ATR con medias simples, igual que volatility_gate.py
    tr  = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    atr = ta.sma(tr, 14)
    up  = high - high[1]
    dn  = low[1] - low
    pdm = up > dn and up > 0 ? up : 0.0
    mdm = dn > pdm and dn > 0 ? dn : 0.0
    pdi = 100 * ta.sma(pdm, 14) / atr
    mdi = 100 * ta.sma(mdm, 14) / atr
    dx  = 100 * math.abs(pdi - mdi) / (pdi + mdi)
    adx = ta.sma(dx, 14)
    [vBull[1], vBear[1], adx[1], atr[1]]

// ── Capa 3: barrido del rango de Asia en M30 + swing de respaldo para el SL ──
f_m30() =>
    h = hour(time, "GMT")
    inAsia = h >= 20
    var float curHi = na
    var float curLo = na
    var float aHi = na
    var float aLo = na
    if inAsia and not inAsia[1]
        curHi := high
        curLo := low
    else if inAsia
        curHi := math.max(curHi, high)
        curLo := math.min(curLo, low)
    if not inAsia and inAsia[1]
        aHi := curHi
        aLo := curLo
    body = math.abs(close - open)
    uw = high - math.max(open, close)
    lw = math.min(open, close) - low
    bullS = not na(aLo) and low < aLo and lw / (body + 1e-10) > 1.5
    bearS = not na(aHi) and high > aHi and uw / (body + 1e-10) > 1.5
    found = math.sum(bullS or bearS ? 1 : 0, 10) > 0
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    var float swH = na
    var float swL = na
    if not na(ph)
        swH := ph
    if not na(pl)
        swL := pl
    lo5 = ta.lowest(low, 5)
    hi5 = ta.highest(high, 5)
    swLo = na(swL) ? lo5 : swL
    swHi = na(swH) ? hi5 : swH
    [found[1], swLo[1], swHi[1]]

// ── Capa 4: CRT de M15 (barrido de la vela anterior + cierre de vuelta) ─────
f_m15() =>
    buf = 0.0001
    rng = high - low
    cB = low < low[1] - buf and close > low[1] and close > open and rng > 0 and (close - open) / rng >= 0.4
    cS = high > high[1] + buf and close < high[1] and close < open and rng > 0 and (open - close) / rng >= 0.4
    // guarda los últimos CRT (índice y nivel) en vez de recorrer el historial
    var array<int>   eBI = array.new<int>()
    var array<float> eBL = array.new<float>()
    var array<int>   eSI = array.new<int>()
    var array<float> eSL = array.new<float>()
    if cB
        array.push(eBI, bar_index)
        array.push(eBL, low)
        if array.size(eBI) > 40
            array.shift(eBI)
            array.shift(eBL)
    if cS
        array.push(eSI, bar_index)
        array.push(eSL, high)
        if array.size(eSI) > 40
            array.shift(eSI)
            array.shift(eSL)
    float frB = na
    float anB = na
    float frS = na
    float anS = na
    if array.size(eBI) > 0
        for k = array.size(eBI) - 1 to 0
            ago = bar_index - array.get(eBI, k)
            if ago >= 2 and ago <= 31
                anB := array.get(eBL, k)
                if ago <= 16
                    frB := anB
                break
    if array.size(eSI) > 0
        for k = array.size(eSI) - 1 to 0
            ago = bar_index - array.get(eSI, k)
            if ago >= 2 and ago <= 31
                anS := array.get(eSL, k)
                if ago <= 16
                    frS := anS
                break
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    var float swH = na
    var float swL = na
    if not na(ph)
        swH := ph
    if not na(pl)
        swL := pl
    lo5 = ta.lowest(low, 5)
    hi5 = ta.highest(high, 5)
    swLo = na(swL) ? lo5 : swL
    swHi = na(swH) ? hi5 : swH
    [frB[1], anB[1], swLo[1], frS[1], anS[1], swHi[1]]

// ── Capa 5: MSS de M5 + rango de vela para el filtro de "spread" ────────────
f_m5() =>
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    ok = not na(sh) and not na(sl)
    hc5 = ta.highest(close, 5)
    lc5 = ta.lowest(close, 5)
    mB = ok and hc5 > sh
    mS = ok and lc5 < sl
    r = high - low
    [mB[1], mS[1], r[1]]

h4bias = request.security(syminfo.tickerid, "240", f_h4(), lookahead=barmerge.lookahead_on)
[h1vB, h1vS, adxH1, atrH1] = request.security(syminfo.tickerid, "60", f_h1(), lookahead=barmerge.lookahead_on)
[m30found, m30swL, m30swH] = request.security(syminfo.tickerid, "30", f_m30(), lookahead=barmerge.lookahead_on)
[crtFB, crtAB, m15swL, crtFS, crtAS, m15swH] = request.security(syminfo.tickerid, "15", f_m15(), lookahead=barmerge.lookahead_on)
[m5B, m5S, m5rng] = request.security(syminfo.tickerid, "5", f_m5(), lookahead=barmerge.lookahead_on)

// ── Capa 6: confirmación en M1 (gráfico actual) ─────────────────────────────
body1 = math.abs(close - open)
rng1  = high - low
uw1   = high - math.max(open, close)
lw1   = math.min(open, close) - low
mom   = (close - close[4]) / close[4] * 100
engB  = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
engS  = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
pinB  = rng1 > 0 and lw1 > body1 * 2 and close > open and body1 / rng1 < 0.3
pinS  = rng1 > 0 and uw1 > body1 * 2 and close < open and body1 / rng1 < 0.3
vAvg20 = ta.sma(volume, 20)
vAvg3  = ta.sma(volume, 3)
volOk = na(volume) or na(vAvg20) or vAvg20 == 0 or vAvg3 >= vAvg20 * 0.8
m1B = ((mom > 0 ? 1 : 0) + (engB ? 1 : 0) + (pinB ? 1 : 0) + (volOk ? 1 : 0)) >= 2
m1S = ((mom < 0 ? 1 : 0) + ((engS and not engB) ? 1 : 0) + (pinS ? 1 : 0) + (volOk ? 1 : 0)) >= 2

// ── Puntuación de confluencia ───────────────────────────────────────────────
dir = nz(h4bias, 0)
l1 = dir != 0
l2 = dir == 1 ? h1vB : dir == -1 ? h1vS : false
l3 = isOrig ? false : m30found
l4 = dir == 1 ? not na(crtFB) : dir == -1 ? not na(crtFS) : false
l5 = dir == 1 ? m5B : dir == -1 ? m5S : false
l6 = dir == 1 ? m1B : dir == -1 ? m1S : false
score = l1 ? 1 + (l2 ? 1 : 0) + (l3 ? 1 : 0) + (l4 ? 1 : 0) + (l5 ? 1 : 0) + (l6 ? 1 : 0) : 0

// ── Filtros ─────────────────────────────────────────────────────────────────
atrPips = atrH1 / pip
gateOk  = not na(adxH1) and adxH1 > adxThr and atrPips >= atrMin and atrPips <= atrMax
spreadOk = not useSpread or (not na(m5rng) and m5rng / pip <= 2)
tMin = hour(time, "GMT") * 60 + minute(time, "GMT")
sessOk = not useSession or (tMin >= 420 and tMin <= 720) or (tMin >= 780 and tMin <= 1020)
var int lastSig = na
cdOk = na(lastSig) or (time - lastSig) >= cooldownMin * 60000

// ── SL / TP (risk/sl_tp_calculator.py) ──────────────────────────────────────
entry = close
float slPx = na
if dir == 1
    lvl = not na(crtAB) ? crtAB : m15swL
    slPx := lvl - 2 * pip
    if math.abs(entry - slPx) / pip < slMin and not na(m30swL)
        slPx := m30swL - 2 * pip
else if dir == -1
    lvl = not na(crtAS) ? crtAS : m15swH
    slPx := lvl + 2 * pip
    if math.abs(entry - slPx) / pip < slMin and not na(m30swH)
        slPx := m30swH + 2 * pip
slDist = math.abs(entry - slPx)
slPips = slDist / pip
sideOk = dir == 1 ? slPx < entry : dir == -1 ? slPx > entry : false
slOk   = not na(slPx) and sideOk and slPips <= slMax
tp1 = dir == 1 ? entry + 1.5 * slDist : entry - 1.5 * slDist
tp2 = dir == 1 ? entry + 2.5 * slDist : entry - 2.5 * slDist
lot = slPips > 0 ? math.max(0.01, math.round(capital * riskPct / 100 / (slPips * pip * contract), 2)) : 0.01

signal = barstate.isconfirmed and l1 and score >= minScore and gateOk and spreadOk and sessOk and cdOk and slOk
longSig  = signal and dir == 1
shortSig = signal and dir == -1
var int nSig = 0
if signal
    lastSig := time
    nSig += 1

// ── Dibujo, alertas y panel ─────────────────────────────────────────────────
nearSig = showNear and barstate.isconfirmed and l1 and score == minScore - 1 and gateOk and sessOk
plotshape(nearSig and not signal, "Casi señal", shape.circle, dir == 1 ? location.belowbar : location.abovebar, color.new(color.orange, 40), size=size.tiny)
plotshape(longSig,  "Compra", shape.triangleup,   location.belowbar, color.new(color.teal, 0), size=size.small, text="BUY")
plotshape(shortSig, "Venta",  shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.small, text="SELL")
if signal and showLevels
    x2 = bar_index + 30
    line.new(bar_index, entry, x2, entry, color=color.gray, width=1)
    line.new(bar_index, slPx, x2, slPx, color=color.red, width=1)
    line.new(bar_index, tp1, x2, tp1, color=color.teal, width=1, style=line.style_dashed)
    line.new(bar_index, tp2, x2, tp2, color=color.teal, width=1)
    txt = (dir == 1 ? "BUY " : "SELL ") + syminfo.ticker + "  " + str.tostring(score) + "/6" +
         "\nEntrada " + str.tostring(entry, format.mintick) + "\nSL " + str.tostring(slPx, format.mintick) + " (" + str.tostring(slPips, "#.0") + " pips)" +
         "\nTP1 " + str.tostring(tp1, format.mintick) + "  TP2 " + str.tostring(tp2, format.mintick) +
         "\nLote " + str.tostring(lot, "#.##") + " (riesgo " + str.tostring(riskPct) + " %)"
    label.new(bar_index, dir == 1 ? low : high, txt, style=dir == 1 ? label.style_label_up : label.style_label_down,
         color=dir == 1 ? color.new(color.teal, 15) : color.new(color.red, 15), textcolor=color.white, size=size.small)
    alert(txt, alert.freq_once_per_bar_close)
alertcondition(longSig,  "KimiBot BUY",  "KimiBot BUY {{ticker}} {{close}}")
alertcondition(shortSig, "KimiBot SELL", "KimiBot SELL {{ticker}} {{close}}")

var table panel = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 20), border_width=1)
f_row(r, name, ok) =>
    table.cell(panel, 0, r, name, text_color=color.white, text_size=size.small)
    table.cell(panel, 1, r, ok ? "✔" : "✘", text_color=ok ? color.lime : color.red, text_size=size.small)
if showPanel and barstate.islast
    table.cell(panel, 0, 0, "KimiBot v3 · " + (isOrig ? "Original" : "Ajustado"), text_color=color.yellow, text_size=size.small)
    table.cell(panel, 1, 0, dir == 1 ? "ALCISTA" : dir == -1 ? "BAJISTA" : "NEUTRAL", text_color=color.yellow, text_size=size.small)
    f_row(1, "1 H4 sesgo", l1)
    f_row(2, "2 H1 OB/FVG", l2)
    f_row(3, "3 M30 barrido Asia", l3)
    f_row(4, "4 M15 CRT", l4)
    f_row(5, "5 M5 MSS", l5)
    f_row(6, "6 M1 entrada", l6)
    f_row(7, "ADX " + str.tostring(adxH1, "#.0") + " · ATR " + str.tostring(atrPips, "#") + " pips", gateOk)
    f_row(8, "Rango M5 ≤ 2 pips", spreadOk)
    f_row(9, "Sesión", sessOk)
    table.cell(panel, 0, 10, timeframe.period == "1" ? "Puntuación" : "¡Usa gráfico de 1 min!", text_color=timeframe.period == "1" ? color.white : color.orange, text_size=size.small)
    table.cell(panel, 1, 10, str.tostring(score) + "/6", text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 11, "Señales en el gráfico", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 11, str.tostring(nSig), text_color=nSig > 0 ? color.lime : color.orange, text_size=size.small)
    hint = nSig > 0 ? "" : isOrig ? "Preset Original: en el oro casi nunca da señal → cambia a Ajustado" : timeframe.period != "1" ? "Pon el gráfico en 1 minuto" : "Sin señales en este historial: amplía el historial o baja la puntuación mínima a 4"
    table.cell(panel, 0, 12, hint, text_color=color.orange, text_size=size.tiny)
    table.cell(panel, 1, 12, "", text_size=size.tiny)
// ── FIN DEL SCRIPT (si al pegar aparece texto debajo de esta línea, bórralo) ──

// ── Órdenes de la estrategia: 50 % en TP1 y 50 % en TP2, ambas con el SL ────
qtyUnits = lot * contract
if longSig and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty=qtyUnits)
    strategy.exit("L-TP1", "L", qty_percent=50, limit=tp1, stop=slPx)
    strategy.exit("L-TP2", "L", qty_percent=100, limit=tp2, stop=slPx)
if shortSig and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty=qtyUnits)
    strategy.exit("S-TP1", "S", qty_percent=50, limit=tp1, stop=slPx)
    strategy.exit("S-TP2", "S", qty_percent=100, limit=tp2, stop=slPx)
